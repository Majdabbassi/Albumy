# =====================================================================
# Albumy environment configuration
# Copy this file to `.env` and adjust values if needed.
# Defaults are chosen so the stack runs out of the box on a fresh clone.
# =====================================================================

# --- MySQL (used by docker-compose.yml) ------------------------------
MYSQL_ROOT_PASSWORD=albumy_root
MYSQL_DATABASE=albumy
MYSQL_USER=albumy
MYSQL_PASSWORD=albumy

# --- Redis (real-time pub/sub, upload sessions, media job queue) ------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend (Spring Boot) -------------------------------------------
# Secrets must be shared with docker-compose so both sides agree.
JWT_SECRET=albumy-dev-only-secret-change-me-in-production

# Base URL used when the backend builds invite registration links.
# Point it at where the Angular frontend is reachable.
FRONTEND_URL=http://localhost:8081

# Comma-separated list of CORS origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost,http://localhost:8081,https://localhost,capacitor://localhost

# Where uploaded files are stored inside the backend container.
UPLOAD_DIR=uploads

# Chunked uploads: 5MB chunks, assembled files up to 2GB.
# UPLOAD_CHUNK_SIZE=5242880
# UPLOAD_MAX_FILE=2147483648

# --- Optional: local (non-Docker) development -------------------------
# Only needed when running the backend with `mvnw spring-boot:run`
# against a locally started MySQL instead of inside Docker.
# DB_URL=jdbc:mysql://localhost:3306/albumy?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=albumy
# DB_PASSWORD=albumy