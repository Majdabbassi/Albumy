# =====================================================================
# Albumy environment configuration
# Copy this file to `.env` and adjust values if needed.
# Defaults are chosen so the stack runs out of the box on a fresh clone.
# =====================================================================

# --- PostgreSQL (used by docker-compose.yml) ------------------------
POSTGRES_DB=albumy
POSTGRES_USER=albumy
POSTGRES_PASSWORD=albumy

# --- Backend (Spring Boot) -------------------------------------------
# JDBC URL the backend uses to reach PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5432/albumy
DB_USER=albumy
DB_PASSWORD=albumy

# Secret used to sign JWT tokens. Keep it long (>32 chars).
# MUST be changed in any non-demo deployment.
JWT_SECRET=albumy-dev-only-secret-change-me-in-production

# Where uploaded files are stored (relative to the backend working dir).
UPLOAD_DIR=uploads