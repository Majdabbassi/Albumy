# =====================================================================
# Albumy environment configuration
# Copy this file to `.env` and adjust values as needed. The only REQUIRED
# value is JWT_SECRET (the backend refuses to boot with the public default).
# =====================================================================

# --- MySQL (used by docker-compose.yml) ------------------------------
MYSQL_ROOT_PASSWORD=albumy_root
MYSQL_DATABASE=albumy
MYSQL_USER=albumy
MYSQL_PASSWORD=albumy

# Host ports published for MySQL and Redis (loopback only). Change them if 3306/6379
# are already taken by another project.
# MYSQL_HOST_PORT=3306
# REDIS_HOST_PORT=6379

# --- Redis (real-time pub/sub, upload sessions, media job queue) ------
REDIS_HOST=redis
REDIS_PORT=6379
# Redis broker password. The container requires auth and only listens on the host's
# loopback, so LAN devices can't enqueue fake media jobs or kill upload sessions.
REDIS_PASSWORD=albumy_redis

# --- Backend (Spring Boot) -------------------------------------------
# REQUIRED — JWT signing key. Generate one with:
#   openssl rand -hex 32
# Uncomment and set it, then copy this file to `.env`. The app refuses to start
# if JWT_SECRET is unset or still the public placeholder (this repo is public).
# JWT_SECRET=

# Base URL used when the backend builds invite registration links.
# Point it at where the Angular frontend is reachable.
FRONTEND_URL=http://localhost:8081

# Comma-separated list of CORS origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost,http://localhost:8081,https://localhost,capacitor://localhost

# Where uploaded files are stored inside the backend container.
UPLOAD_DIR=uploads

# Chunked uploads: 5MB chunks, assembled files up to 2GB.
# UPLOAD_CHUNK_SIZE=5242880
# UPLOAD_MAX_FILE=2147483648

# --- Optional: local (non-Docker) development -------------------------
# Only needed when running the backend with `mvnw spring-boot:run`
# against a locally started MySQL instead of inside Docker.
# DB_URL=jdbc:mysql://localhost:3306/albumy?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=albumy
# DB_PASSWORD=albumy

# --- Optional: hosting on a free tier (see render.yaml) ----------------
# REDIS_SSL=true              # managed Redis that requires TLS
# MEDIA_JOBS_POLL_MS=1000     # how often the worker checks Redis (default 250)
# SPRING_PROFILES_ACTIVE=embedded-worker   # run the media worker inside the web process
# DEMO_RECONCILE_STORAGE=true # disposable disk: drop rows whose files vanished, re-seed demo
